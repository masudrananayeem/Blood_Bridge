# ---- Backend API -----------------------------------------------------------
# Same-origin base so the real backend URL never reaches the browser.
# In dev, Vite proxies /api to API_PROXY_ORIGIN. On Cloudflare Pages, the
# functions/api/[[path]].js function forwards /api/* to the API_ORIGIN env var
# (set in the Pages dashboard, NOT here and never shipped to the client).
VITE_API_URL=/api

# Backend origin used by the Vite dev server proxy only.
# This is NOT a VITE_ variable, so Vite never inlines it into the client bundle.
# API_PROXY_ORIGIN=

# ---- Firebase Authentication ----------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Cloudinary ------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- Cloudflare Pages only (server-side, set in the dashboard) -------------
# API_ORIGIN=
