PORT=5000
NODE_ENV=development

# JWT (used to sign the backend's own session tokens)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Firebase service account.
# Either the legacy single-line base64 JSON, OR the raw JSON in a .env-friendly
# single line (see FIREBASE_SERVICE_ACCOUNT below). Pick one — if both are set,
# the base64 value wins.
#   base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudinary (image deletion only; uploads happen directly from the browser)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CLIENT_URL=http://localhost:5173

# ---- Cloudflare Workers notes ----
# Deploy the same code with `npx wrangler deploy` (entry: worker.js).
# Set secrets there with `wrangler secret put <NAME>` for every non-var above:
#   wrangler secret put FIREBASE_SERVICE_ACCOUNT_BASE64
#   wrangler secret put JWT_SECRET
#   wrangler secret put CLOUDINARY_CLOUD_NAME
#   wrangler secret put CLOUDINARY_API_KEY
#   wrangler secret put CLOUDINARY_API_SECRET
# Non-secret values (CLIENT_URL) go in [vars] inside wrangler.toml.